{
    "manifest_version": 3,
    "name": "Tencil",
    "version": "0.0.1",
    "description": "Load the Tencil overlay into a running app without adding its script tag.",
    "permissions": ["activeTab", "scripting", "storage"],
    "host_permissions": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://*.localhost/*",
        "https://localhost/*",
        "https://*.localhost/*"
    ],
    "background": { "service_worker": "background.js" },
    "action": { "default_title": "Turn on Tencil for this site" }
}
