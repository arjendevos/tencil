{
    "$schema": "https://turborepo.com/schema.json",
    "agentGuidance": false,
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "test:e2e": {
            "dependsOn": ["^build"],
            "cache": false
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    },
    "ui": "stream"
}
