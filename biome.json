{
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    "extends": ["biome-config-pixel"],
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "!**/dist",
            "!**/.pack",
            "!**/test-results",
            "!**/playwright-report",
            "!.claude"
        ]
    },
    "linter": {
        "rules": {
            "style": {
                "noNonNullAssertion": "off",
                "noRestrictedImports": "off"
            },
            "nursery": {
                "useSortedClasses": "off"
            }
        }
    }
}
