{
    "name": "fixhere-monorepo",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.34.5",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "typecheck": "turbo run typecheck",
        "test": "vitest run",
        "lint": "biome check .",
        "format": "biome check --write .",
        "changeset": "changeset",
        "release": "pnpm build && changeset publish",
        "check": "pnpm lint && pnpm typecheck && pnpm test",
        "test:e2e": "turbo run test:e2e",
        "pack:local": "turbo run build --filter=fixhere && node scripts/pack-local.mjs"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@changesets/changelog-github": "^1.0.1",
        "@changesets/cli": "^3.0.3",
        "@types/node": "^24.0.0",
        "biome-config-pixel": "^2.1.7",
        "turbo": "^2.11.7",
        "typescript": "6.0.3",
        "vitest": "^5.0.3"
    }
}
