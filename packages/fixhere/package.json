{
  "name": "fixhere",
  "version": "0.0.1",
  "description": "Point at any element of your running app and tell your coding agent what to fix.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "agent",
    "ai",
    "t3code",
    "claude-code",
    "devtools",
    "react",
    "review",
    "comments"
  ],
  "bin": {
    "fixhere": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    },
    "./next": {
      "types": "./dist/next.d.mts",
      "default": "./dist/next.mjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "default": "./dist/react.mjs"
    },
    "./overlay.js": "./dist/overlay.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && cp ../overlay/dist/fixhere.global.js dist/overlay.global.js",
    "dev": "node --watch --experimental-strip-types src/cli.ts --root ../../apps/playground",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fixhere/overlay": "workspace:*",
    "@fixhere/protocol": "workspace:*",
    "@fixhere/provider-t3code": "workspace:*",
    "@types/ws": "^8.18.2",
    "tsdown": "^0.23.0",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "@fixhere/testing": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": ">=18",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
